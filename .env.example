# ==============================================================================
# 7ME3 12-Factor App Environment Configuration
# ==============================================================================
# Factor III: Store config in the environment.
# Backing services are configured strictly via environment variables.

# Environment Mode: development | staging | production
APP_ENV=development

# Factor VII: Port binding
PORT=8080
WORKER_HEALTH_PORT=8081

# Factor XI: Logs as event streams (pretty for terminal, json for CloudWatch/GCP Cloud Logging/Datadog)
LOG_FORMAT=pretty
RUST_LOG=info,platform=debug,api_service=debug,worker_service=debug

# Factor IV: Backing Services - Database (Postgres)
# Can be local Postgres, AWS Aurora/RDS, GCP Cloud SQL, or Bare Metal.
# Supports secret reference syntax: e.g. postgres://user:secret://DB_PASSWORD@host:5432/db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders_db
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2

# Factor XII: Admin processes (Auto-apply migrations on startup)
AUTO_MIGRATE=true

# ==============================================================================
# Secrets Abstraction (SECRETS_PROVIDER)
# ==============================================================================
# Options:
#   - env: Reads from environment variables (Default for local & bare metal)
#   - file: Reads from mounted directory (Kubernetes Secrets / Confidential VM tmpfs)
#   - aws: AWS Secrets Manager (AWS EC2 IAM Role, EKS IRSA, Nitro Enclave)
#   - gcp: GCP Secret Manager (GCE Service Account, GKE Workload Identity, Confidential VM)
SECRETS_PROVIDER=env

# Required when SECRETS_PROVIDER=file (e.g. /etc/secrets in K8s, /dev/shm/secrets in Confidential VM)
SECRETS_DIR=/etc/secrets

# Required when SECRETS_PROVIDER=gcp
# GCP_PROJECT_ID=my-gcp-project-123

# Example secret key for verification and audit endpoint
AUDIT_SECRET_KEY=APP_ENCRYPTION_KEY
APP_ENCRYPTION_KEY=demo-super-secret-key-1234567890

# ==============================================================================
# Messaging Abstraction (MESSAGE_BUS_BACKEND)
# ==============================================================================
# Options:
#   - inmemory: Zero-infrastructure async pub/sub for instant local dev & tests
#   - kafka: Apache Kafka, Redpanda, AWS MSK, or GCP Managed Kafka
MESSAGE_BUS_BACKEND=inmemory

# Required when MESSAGE_BUS_BACKEND=kafka
KAFKA_BROKERS=localhost:9092
